# Copy to .env (gitignored) and fill in. Never commit real keys.

# BAND user API key (app.band.ai → Settings → API keys). Used by `onsen-register` and `onsen-smoke`.
BAND_USER_KEY=band_u_...

# Nimble (online.nimbleway.com → Settings → API Keys). Used by the Scout.
NIMBLE_API_KEY=...

# Anthropic API key. The Examiner uses Claude to write the sealed exam and judge `judge` steps.
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs, only for the demo voiceover (scripts/voiceover.py).
ELEVENLABS_API_KEY=sk_...

# Where the product is being built (printed by scripts/new-run.sh). The Scout saves docs and data here.
ONSEN_WORKSPACE=

# Optional tuning
# ONSEN_HOME=~/.onsen                  # agent keys + state, outside the repo
# ONSEN_EXAMINER_MODEL=claude-opus-5-5
# ONSEN_SCENARIOS_PER_STAGE=8
# ONSEN_PASS_THRESHOLD=0.9
# ONSEN_THRASH_LIMIT=3                 # failing rounds without improvement before a chill break
# ONSEN_MAX_ROUNDS_PER_STAGE=6
# ONSEN_CHILL_ACTION=remove            # remove | notice
# ONSEN_NIMBLE_EFFORT=low              # low | medium | high
