{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "wandb": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "W&B Inference",
      "options": {
        "baseURL": "https://api.inference.wandb.ai/v1",
        "apiKey": "{env:WANDB_API_KEY}"
      },
      "models": {
        "Qwen/Qwen3.8-27B": {
          "name": "Qwen 3.8 27B",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    }
  },
  "model": "wandb/Qwen/Qwen3.8-27B",
  "small_model": "wandb/Qwen/Qwen3.8-27B",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny",
    "external_directory": "deny"
  },
  "agent": {
    "onsen-architect": {
      "description": "Onsen Architect: plans, hands out stages, writes PLAN.md only",
      "mode": "primary",
      "permission": { "edit": "allow", "bash": "allow", "webfetch": "deny", "external_directory": "deny" }
    },
    "onsen-builder": {
      "description": "Onsen Builder: implements one stage at a time in the workspace",
      "mode": "primary",
      "permission": { "edit": "allow", "bash": "allow", "webfetch": "deny", "external_directory": "deny" }
    },
    "onsen-reviewer": {
      "description": "Onsen Reviewer: reads diffs and says no; cannot edit files",
      "mode": "primary",
      "permission": { "edit": "deny", "bash": "allow", "webfetch": "deny", "external_directory": "deny" }
    }
  }
}
