{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "wandb": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "W&B Inference",
      "options": {
        "baseURL": "https://api.inference.wandb.ai/v1",
        "apiKey": "{env:WANDB_API_KEY}"
      },
      "models": {
        "Qwen/Qwen3.8-27B": {
          "name": "Qwen 3.8 27B",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "options": {
            "reasoningEffort": "none"
          }
        }
      }
    },
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 400000,
            "output": 64000
          },
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "model": "openai/gpt-6-luna",
  "small_model": "openai/gpt-6-luna",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny",
    "external_directory": "deny",
    "question": "deny"
  },
  "agent": {
    "onsen-architect": {
      "description": "Onsen Architect: leads the band; plans, hands off whole tasks, reports",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "external_directory": "allow",
        "question": "deny"
      },
      "tools": {
        "jam-runtime_AskUserQuestion": false
      }
    },
    "onsen-builder": {
      "description": "Onsen Builder: implements one stage at a time in the workspace",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "external_directory": "deny",
        "question": "deny"
      },
      "tools": {
        "jam-runtime_AskUserQuestion": false
      }
    },
    "onsen-reviewer": {
      "description": "Onsen Reviewer: reads diffs and says no; cannot edit files",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "webfetch": "deny",
        "external_directory": "deny",
        "question": "deny"
      },
      "tools": {
        "jam-runtime_AskUserQuestion": false
      }
    },
    "onsen-examiner": {
      "description": "Onsen Examiner: writes and runs the band's sealed exam in its own workspace",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "external_directory": "deny",
        "question": "deny"
      },
      "tools": {
        "jam-runtime_AskUserQuestion": false
      }
    }
  },
  "tools": {
    "jam-runtime_AskUserQuestion": false
  }
}
