#!/usr/bin/env python3
"""Onsen's room linter, in front of the real `band` CLI on the seats' PATH.

`band send` posts only protocol messages: after its mentions, a message starts with a protocol tag, and a message
to Nap Guard carries one of the tags Nap Guard reads. A seat hands off or judges each commit once: a second `[ready]`
or `[review]` from the same seat for the same commit is refused. A verdict is only for a commit the Builder handed off
with `[ready]`, and nothing more is handed off or judged in a stage Nap Guard has accepted. Every other band command
passes straight through.
"""
import json
import os
import pathlib
import re
import subprocess
import sys
import time

HERE = pathlib.Path(__file__).resolve().parent
TAGS = {"plan", "task", "seal", "ready", "exam", "review", "dispute", "reveal", "report", "decide"}
OWNERS = {"plan": {"Architect"}, "task": {"Architect"}, "report": {"Architect"}, "decide": {"Architect"},
          "ready": {"Builder"}, "seal": {"Examiner"}, "exam": {"Examiner"}, "reveal": {"Examiner"},
          "review": {"Reviewer"}, "dispute": {"Builder", "Examiner", "Reviewer", "Architect"}}
FOR_NAP_GUARD = {"seal", "exam", "review", "report", "dispute"}
QUESTIONS = {"question", "blocking-question", "ask", "help"}
VALUE_OPTS = {"--profile", "--session", "--scope", "--config-dir", "--as", "--body-file", "--artifact", "--type",
              "--page", "--cursor"}
MENTION = r"@(?:\[\[[0-9a-f-]+\]\]|[\w.-]+(?:/[\w.-]+)?)"
HEAD = re.compile(rf"^((?:\s*{MENTION})*)\s*\[([A-Za-z-]+)\]")


def real_band() -> str:
    for d in os.environ.get("PATH", "").split(os.pathsep):
        try:
            if not d or pathlib.Path(d).resolve() == HERE:
                continue
        except OSError:
            continue
        c = pathlib.Path(d) / "band"
        if c.is_file() and os.access(c, os.X_OK):
            return str(c)
    return "/usr/bin/band"


def refuse(why: str) -> None:
    print(f"Not sent. {why}", file=sys.stderr)
    raise SystemExit(2)


def body_of(args: list[str]) -> str | None:
    positional, i = [], 0
    while i < len(args):
        a = args[i]
        if a == "--body-file" and i + 1 < len(args):
            return pathlib.Path(args[i + 1]).read_text(encoding="utf-8")
        if a.startswith("--body-file="):
            return pathlib.Path(a.split("=", 1)[1]).read_text(encoding="utf-8")
        if a in VALUE_OPTS:
            i += 2
            continue
        if not a.startswith("-"):
            positional.append(a)
        i += 1
    return positional[1] if len(positional) > 1 else None


# What each tag's first line must carry, so the gate can read it.
FORMAT = {
    "ready": (("stage", r"\bstage=\d+\b"), ("commit", r"\bcommit=[0-9a-f]{7,40}\b")),
    "review": (("stage", r"\bstage=\d+\b"), ("commit", r"\bcommit=[0-9a-f]{7,40}\b"),
               ("APPROVED or BLOCKED", r"\b(?:APPROVED|BLOCKED)\b")),
    "exam": (("stage", r"\bstage=\d+\b"), ("passed", r"\bpassed=\d+/\d+\b"), ("commit", r"\bcommit=[0-9a-f]{7,40}\b")),
    "seal": (("stage", r"\bstage=\d+\b"), ("sha256", r"\bsha256=[0-9a-f]{64}\b")),
    "dispute": (("stage", r"\bstage=\d+\b"),),
    "task": (("stage", r"\bstage=\d+\b"),),
}
EXAMPLE = {
    "ready": "@<examiner> @<reviewer> [ready] stage=1 commit=abc1234 <what changed>",
    "review": "@<builder> @<nap guard> [review] stage=1 commit=abc1234 BLOCKED: <file:line and the requirement>",
    "exam": "the first line onsen-exam wrote, unchanged",
    "seal": "the first line onsen-exam seal wrote, unchanged",
    "dispute": "@<seat> @<nap guard> [dispute] stage=1 commit=abc1234 <requirement text and evidence>",
    "task": "@<seats> [task] stage=1 part=1/3 <the requirements>",
}


def lint(text: str) -> None:
    m = HEAD.match(text.lstrip())
    if not m:
        refuse("A room message starts with its mentions and then a protocol tag ([task], [ready], [exam], [review], "
               "[dispute], [reveal], [report], ...). If you have nothing to hand off, end your turn: whoever needs "
               "you next will mention you, and that wakes you.")
    mentions, tag = m.group(1), m.group(2).lower()
    if tag in QUESTIONS:
        refuse("In a dark run nobody answers questions: decide from the requirements, state the assumption in your "
               "next handoff, and keep going.")
    if tag not in TAGS:
        refuse(f"[{tag}] isn't a protocol tag. The tags are: " + ", ".join(f"[{t}]" for t in sorted(TAGS)) + ".")
    seat = os.environ.get("GIT_AUTHOR_NAME", "")
    if seat in {"Architect", "Builder", "Examiner", "Reviewer"} and seat not in OWNERS[tag]:
        who = " or ".join(sorted(OWNERS[tag]))
        refuse(f"Only the {who} posts [{tag}]; you are the {seat}. A handoff you received is already with everyone it "
               "names: don't forward it. Do your own part, and end your turn when you are waiting.")
    first = text.lstrip().splitlines()[0] if text.strip() else ""
    missing = [name for name, rx in FORMAT.get(tag, ()) if not re.search(rx, first)]
    if missing:
        refuse(f"A [{tag}] needs {', '.join(missing)} on its first line, so the gate can read it; for example: "
               f"{EXAMPLE[tag]}")
    if re.search(r"nap-guard|nap guard", mentions, re.I) and tag not in FOR_NAP_GUARD:
        refuse("Nap Guard reads only [seal], [exam], [review], [dispute] and [report]. It posts [gate], [chill] and "
               "[nudge] on its own and mentions you when it does; don't ask it for status. End your turn now.")


ONCE = {"ready": "You already handed off commit {c} with [ready]. A new [ready] needs a new commit. If you disagree "
                 "with a verdict on {c}, post one [dispute] stage=N commit={c} with your evidence to the seat that gave "
                 "it, then end your turn.",
        "review": "You already gave commit {c} its verdict. Judge each handed-off commit once: a repeated [ready] for "
                  "{c} needs no reply. End your turn.",
        "exam": "You already posted this result for commit {c}. Grade each handed-off commit once (again only after "
                "voiding a check). End your turn.",
        "task": "You already posted {c}, and every seat it names has it. Post each part once: a "
                "seat that hasn't seen a part yet gets it with the rest, one per turn. End your turn.",
        "seal": "You already posted this seal ({c}); it stands until the stage is accepted. End your turn: the next "
                "[ready] wakes you."}


def once_key(text: str) -> tuple[str, str] | None:
    """(tag, what) for a message that may be sent once: a handoff or verdict per commit, a task part per stage, a seal
    per stage."""
    m = HEAD.match(text.lstrip())
    tag = m.group(2).lower() if m else ""
    first = text.lstrip().splitlines()[0] if text.strip() else ""
    n = re.search(r"\bstage=(\d+)\b", first)
    if tag == "task" and n:  # Run T: the Architect re-sent part 4/4 five times while a seat said it was missing
        part = re.search(r"\bpart=(\d+)/\d+", first)
        return (tag, f"part {part.group(1)} of stage {n.group(1)}'s task") if part else None
    if tag == "seal" and n:  # Run T: the Examiner re-posted its seal four times. A new hash (re-sealed before any
        h = re.search(r"\bsha256=([0-9a-f]{12})", first)  # grading, as Run U's stage 4 was) is news and must post.
        return tag, f"stage {n.group(1)}" + (f" ({h.group(1)})" if h else "")
    c = re.search(r"\bcommit=([0-9a-f]{7,40})\b", text)
    if tag not in ONCE or not c:
        return None
    if tag == "review":  # a verdict may change once (after a dispute), but never repeat
        tag += ":APPROVED" if re.search(r"\bAPPROVED\b", text) and not re.search(r"\bBLOCKED\b", text) else ":BLOCKED"
    if tag == "exam":  # the same result twice is a repeat; a different one (after a void) is news
        n = re.search(r"\bpassed=(\d+/\d+)", text)
        tag += ":" + (n.group(1) if n else "?")
    return tag, c.group(1)[:7]


def onsen_home() -> pathlib.Path:
    return pathlib.Path(os.environ.get("ONSEN_HOME") or pathlib.Path.home() / ".onsen")


def ledger(room: str, seat: str | None = None) -> pathlib.Path:
    return onsen_home() / "linter" / f"{room}-{seat or os.environ.get('GIT_AUTHOR_NAME', 'seat')}.json"


def accepted_stages(room: str) -> set[str]:
    """The stages Nap Guard has accepted in this room, from its state file (none if it can't be read)."""
    try:
        state = json.loads((onsen_home() / "state" / f"napguard-{room}.json").read_text())
        return {k for k, v in state.get("stages", {}).items() if v.get("accepted")}
    except (OSError, ValueError, AttributeError):
        return set()


def handed_off(real: str, room: str, commit: str) -> bool:
    """Whether a `[ready]` names this commit: the Builder's own ledger first, then the room's newest messages.
    If the room can't be read, the verdict goes through: the linter never blocks on its own failure."""
    try:
        if f"ready:{commit[:7]}" in json.loads(ledger(room, "Builder").read_text()):
            return True
    except (OSError, ValueError):
        pass
    try:
        out = subprocess.run([real, "room", "messages", room, "--json", "--type", "text"], capture_output=True,
                             text=True, timeout=30).stdout
        page = json.loads(out)
        msgs = page if isinstance(page, list) else page.get("messages") or page.get("data") or []
    except (OSError, ValueError, subprocess.SubprocessError, AttributeError):
        return True
    named = re.compile(rf"\bcommit={re.escape(commit[:7])}")
    for m in msgs:
        content = (m.get("content") or "").lstrip() if isinstance(m, dict) else ""
        h = HEAD.match(content)  # a message that IS a [ready], not one that quotes one
        if h and h.group(2).lower() == "ready" and named.search(content.splitlines()[0]):
            return True
    return False


CLOSED = ("Stage {n} is accepted, so it is closed: its folder is final and nothing more is handed off or judged there. "
          "Work on stage {after} (the Architect's [task] stage={after} carries its requirements); if you have nothing "
          "to do yet, end your turn.")
UNHANDED = ("No [ready] names commit {c}: verdicts are only for commits the Builder handed off, and the gate counts "
            "only those. End your turn; the Builder's [ready] wakes you.")
UNJUDGED = ("A [dispute] answers a verdict ([exam] or [review]) on a commit, and nothing has judged {c}. If a handoff's "
            "parts are still arriving, keep each one and end your turn: BAND gives you the rest one per turn, and the "
            "last part starts your work.")


def judged(real: str, room: str, commit: str) -> bool:
    """Whether an [exam] or [review] names this commit: the graders' ledgers first, then the room's newest messages.
    If the room can't be read, the dispute goes through."""
    for seat in ("Examiner", "Reviewer"):
        try:
            if any(str(k).endswith(":" + commit[:7]) for k in json.loads(ledger(room, seat).read_text())):
                return True
        except (OSError, ValueError):
            pass
    try:
        out = subprocess.run([real, "room", "messages", room, "--json", "--type", "text"], capture_output=True,
                             text=True, timeout=30).stdout
        page = json.loads(out)
        msgs = page if isinstance(page, list) else page.get("messages") or page.get("data") or []
    except (OSError, ValueError, subprocess.SubprocessError, AttributeError):
        return True
    named = re.compile(rf"\bcommit={re.escape(commit[:7])}")
    for m in msgs:
        content = (m.get("content") or "").lstrip() if isinstance(m, dict) else ""
        h = HEAD.match(content)
        if h and h.group(2).lower() in ("exam", "review") and named.search(content.splitlines()[0]):
            return True
    return False


def report_too_early(room: str, at: float | None = None) -> str | None:
    """Why a final [report] would end the run too early, or None: the run ends when its last stage is accepted, or when
    the open stage has used its whole time budget (the plan run-dark.sh writes, and Nap Guard's acceptance times). Run
    T's Architect reported three minutes in, amid a confused handoff, and the run ended there."""
    try:
        plan = json.loads((onsen_home() / "run" / "current.json").read_text())
    except (OSError, ValueError):
        return None
    try:
        stages = json.loads((onsen_home() / "state" / f"napguard-{room}.json").read_text()).get("stages", {})
    except (OSError, ValueError, AttributeError):
        stages = {}
    accepted = sorted(int(k) for k, v in stages.items() if isinstance(v, dict) and v.get("accepted"))
    if int(plan.get("stages") or 0) in accepted:
        return None
    open_stage = (accepted[-1] + 1) if accepted else 1
    opened = (stages.get(str(accepted[-1])) or {}).get("accepted_at") if accepted else None
    opened = float(opened or plan.get("started_at") or 0)
    budget = float(plan.get("stage_budget_min") or 120)
    spent = ((at or time.time()) - opened) / 60
    if spent >= budget:
        return None
    return (f"The run isn't over: stage {open_stage} has been open for {spent:.0f} of its {budget:.0f} minutes, and "
            f"the band reports only when the last stage is accepted or the open stage's time is spent. Keep working on "
            f"stage {open_stage}: resend whatever a seat is missing, then end your turn; the next handoff or verdict "
            f"wakes you.")


def check_flow(real: str, room: str, text: str) -> None:
    """Refuse a handoff or verdict in an accepted stage, and a verdict on a commit nobody handed off."""
    m = HEAD.match(text.lstrip())
    tag = m.group(2).lower() if m else ""
    first = text.lstrip().splitlines()[0] if text.strip() else ""
    n = re.search(r"\bstage=(\d+)\b", first)
    if tag in {"ready", "review", "exam", "dispute"} and n and n.group(1) in accepted_stages(room):
        refuse(CLOSED.format(n=n.group(1), after=int(n.group(1)) + 1))
    c = re.search(r"\bcommit=([0-9a-f]{7,40})\b", first)
    if tag in {"review", "exam"} and c and not handed_off(real, room, c.group(1)):
        refuse(UNHANDED.format(c=c.group(1)[:7]))
    if tag == "dispute" and c and not judged(real, room, c.group(1)):
        refuse(UNJUDGED.format(c=c.group(1)[:7]))
    if tag == "report":
        early = report_too_early(room)
        if early:
            refuse(early)


def main() -> None:
    args = sys.argv[1:]
    real = real_band()
    try:
        i = next(k for k, a in enumerate(args) if a == "send" and (k == 0 or args[k - 1] not in VALUE_OPTS))
    except StopIteration:
        os.execv(real, [real] + args)
    text = body_of(args[i + 1:])
    if text is None:
        os.execv(real, [real] + args)
    lint(text)
    key = once_key(text)
    positional = [a for k, a in enumerate(args[i + 1:]) if not a.startswith("-")
                  and (k == 0 or args[i + k] not in VALUE_OPTS)]
    room = positional[0] if positional else "room"
    check_flow(real, room, text)
    book = ledger(room)
    sent = json.loads(book.read_text()) if key and book.exists() else []
    if key and f"{key[0]}:{key[1]}" in sent:
        refuse(ONCE[key[0].split(":")[0]].format(c=key[1]))
    rc = subprocess.run([real] + args).returncode
    if rc == 0 and key:
        book.parent.mkdir(parents=True, exist_ok=True)
        book.write_text(json.dumps(sent + [f"{key[0]}:{key[1]}"]))
    raise SystemExit(rc)


if __name__ == "__main__":
    main()
