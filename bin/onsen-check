#!/usr/bin/env bash
# Run the task's acceptance checker against one committed revision, never the live working tree.
#
#   onsen-check <repo> <stage> [<commit>] [--isolated]
#
# Checks out <commit> (default HEAD) into a throwaway worktree, runs the checker the task supplies
# (ONSEN_CHECKER_DIR, ONSEN_CHECKER_PY, ONSEN_TRACK), and prints its verdict lines plus every failing
# check with its first error line. The full logs stay in the printed output directory.
#
# A run is capped (ONSEN_CHECK_CAP seconds, default 5 minutes plus 3 per stage): a healthy suite takes a few minutes,
# and a service that is slow or hung under test would otherwise keep the checker, and its lock, busy for an hour. The
# harness runs in its own process group under `timeout`, so the cap holds even if this script is killed, and it is
# interrupted (not killed) first, so it removes the containers it started.
set -uo pipefail
repo=${1:?repo}; stage=${2:?stage}; commit=HEAD; mode=host
shift 2
for a in "$@"; do case "$a" in --isolated) mode=isolated ;; *) commit=$a ;; esac; done
: "${ONSEN_CHECKER_DIR:?the checker package directory (from the task)}"
: "${ONSEN_TRACK:?the track name (from the task)}"
py=${ONSEN_CHECKER_PY:-python3}
# The checker's browser suites need Chromium; use the machine's preinstalled one when it has it.
[ -z "${PLAYWRIGHT_BROWSERS_PATH:-}" ] && [ -d /opt/pw-browsers ] && export PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
sha=$(git -C "$repo" rev-parse --short "$commit") || exit 2
# One checker at a time on this machine: seats and Nap Guard queue for it.
lock="${ONSEN_HOME:-$HOME/.onsen}/onsen-check.lock"; mkdir -p "$(dirname "$lock")"
exec 9>"$lock"
flock -n 9 || { echo "another check is running; waiting for it (one checker at a time)"; flock 9; }
work=$(mktemp -d /tmp/onsen-check-XXXXXX)
git -C "$repo" worktree add --detach -q "$work/repo" "$sha" || exit 2
out="${ONSEN_CHECKS_DIR:-$HOME/.onsen/checks}/stage$stage-$sha-$(date +%H%M%S)"
mkdir -p "$(dirname "$out")"
cap=${ONSEN_CHECK_CAP:-$((300 + 180 * stage))}
console="$out.console.log"
echo "checking stage $stage at commit $sha ($mode mode): it builds the service and runs the suite, usually a few minutes" \
     "(stopped after $((cap / 60)) min); give this command a timeout of at least $((cap / 60 + 2)) minutes"
( cd "$ONSEN_CHECKER_DIR" && exec setsid timeout -s INT -k 30 "$cap" "$py" -m harness run --track "$ONSEN_TRACK" \
    --repo "$work/repo" --stage "$stage" --mode "$mode" --out "$out" ) > "$console" 2>&1 &
hp=$!
trap 'kill -INT -- -$hp 2>/dev/null; sleep 5; kill -KILL -- -$hp 2>/dev/null; git -C "$repo" worktree remove --force "$work/repo" >/dev/null 2>&1; rm -rf "$work"; exit 143' TERM INT HUP
wait $hp; rc=$?
trap - TERM INT HUP
grep -v "^NOTE:" "$console" | tail -12
if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
  echo "--- stopped: the check did not finish within $((cap / 60)) minutes. A healthy run of this suite takes a few"
  echo "    minutes, so the service is probably slow or hung under test (a busy loop, or a request or build that never"
  echo "    finishes), and every check waits for it. Start the commit with onsen-serve and time a build and a few"
  echo "    requests before checking again."
fi
echo "--- failing checks (first error line each):"
grep -h "^FAILED\|^ERROR" "$out"/stage-*.log 2>/dev/null | cut -c1-260 | head -40
echo "--- why each one failed (the assertion lines from the checker's log):"
for log in "$out"/stage-*.log; do
  awk '/^_____+ .* _____+$/ { name = $0; gsub(/^_+ | _+$/, "", name); shown = 0; next }
       /^E / && name != "" && shown < 6 { if (shown == 0) print "* " name; print "    " substr($0, 1, 240); shown++ }' "$log"
done 2>/dev/null | head -150
echo "--- full logs: $out"
# The moment a revision claims the stage is the moment to hand it off: graders waiting on a Builder that keeps
# polishing is time the band loses, and a later revision gets its own [ready].
claimed=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("claimed_stage") or "")' "$out/report.json" 2>/dev/null)
if [ "$claimed" = "$stage" ]; then
  echo "--- the checker claims stage $stage on commit $sha. If you are the Builder and haven't handed this commit off yet,"
  echo "    do it now: post [ready] stage=$stage commit=$sha to the Examiner and the Reviewer, with the result line above."
  echo "    Then keep improving in new revisions: the failures listed above are your next work, each with its own [ready]."
fi
git -C "$repo" worktree remove --force "$work/repo" >/dev/null 2>&1; rm -rf "$work"
